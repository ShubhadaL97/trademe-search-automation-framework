# TradeMe Search Automation - Environment Configuration

# Base URL for the application
BASE_URL=https://www.tmsandbox.co.nz/

# Timeout settings (in milliseconds)
SHORT_TIMEOUT=3000
MEDIUM_TIMEOUT=5000
LONG_TIMEOUT=10000

# Wait times for specific elements
SUGGESTIONS_WAIT=2000
RESULTS_WAIT=4000
PAGE_LOAD_WAIT=5000

# Performance thresholds (in milliseconds)
MAX_SUGGESTIONS_LOAD_TIME=2000
MAX_RESULTS_LOAD_TIME=4000
MAX_PAGE_LOAD_TIME=5000

# Playwright settings
PLAYWRIGHT_WORKERS=4
PLAYWRIGHT_RETRIES=2
PLAYWRIGHT_TIMEOUT=30000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/test.log

# CI/CD settings
CI=false
DEBUG=false

# Browser settings
HEADED=false
SLOW_MO=0

# Report settings
REPORT_TYPE=html
REPORT_DIR=./test-results

# Custom data
SEARCH_TERMS=laptop,phone,camera,furniture,car
TEST_EMAIL=test@example.com
TEST_PASSWORD=password123
